{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Claude CLI",
      "type": "process",
      "command": "/usr/bin/tmux",
      "args": [
        "new-session",
        "-A",
        "-s",
        "claude-${workspaceFolderBasename}",
        "-c",
        "${workspaceFolder}",
        "/home/wacavitg/.local/bin/claude"
      ],
      "presentation": {
        "panel": "dedicated",
        "focus": true,
        "reveal": "always"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "runOptions": {
          "runOn": "folderOpen"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Start Codex CLI",
      "type": "process",
      "command": "/usr/bin/tmux",
      "args": [
        "new-session",
        "-A",
        "-s",
        "codex-${workspaceFolderBasename}",
        "-c",
        "${workspaceFolder}",
        "/home/wacavitg/.local/bin/codex"
      ],
      "presentation": {
        "panel": "dedicated",
        "focus": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Web.Api/Web.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Lint Markdown",
      "type": "shell",
      "command": "./scripts/markdownlint.sh",
      "args": [
        "."
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Update tasks.md",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.scripts/update-tasks-md.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "runOptions": {
          "runOn": "folderOpen"
        }
      },
      "problemMatcher": []
    }
  ]
}